# Copy to .env next to the compose file.

# First start only: hashed into /data/mkpk-admin.json, then changeable in the UI.
# Use something long — this single password is the whole gate.
MKPK_ADMIN_PASSWORD=change-me-please-long

# compose.caddy.yaml only: the domain Caddy gets a certificate for, and the
# address Let's Encrypt uses for expiry warnings.
MKPK_DOMAIN=mkpk.example.com
MKPK_ACME_EMAIL=admin@example.com

# Pin a version instead of :latest once you are in production.
# MKPK_IMAGE=registry.gitlab.eg23.ru/lazygatto/mikrotik-psk-knock/provision:v0.9.0
