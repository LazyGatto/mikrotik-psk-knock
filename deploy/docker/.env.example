# Copy to .env next to the compose file.

# First start only: hashed into /data/mkpk-admin.json, then changeable in the UI.
# Use something long — this single password is the whole gate.
MKPK_ADMIN_PASSWORD=change-me-please-long

# compose.yaml only: where to publish the port. Loopback suits a proxy on this
# same host. For an ingress elsewhere use 0.0.0.0 (survives a DHCP address
# change) or a fixed LAN address; either way the hop to the proxy is plain HTTP.
# MKPK_BIND=0.0.0.0
# MKPK_PORT=8765

# compose.caddy.yaml only: the domain Caddy gets a certificate for, and the
# address Let's Encrypt uses for expiry warnings.
MKPK_DOMAIN=mkpk.example.com
MKPK_ACME_EMAIL=admin@example.com

# Required: where to pull the provision image from. CI publishes it to the
# container registry of this project on every tag — copy the exact path from
# GitLab: Deploy → Container Registry (it looks like
# <gitlab-host>:5050/<group>/<project>/provision). Pin a version in production
# instead of :latest.
MKPK_IMAGE=<your-gitlab-host>:5050/<group>/<project>/provision:v0.12.0
