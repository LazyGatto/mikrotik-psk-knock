<?xml version="1.0" encoding="UTF-8"?>
<!--
  Release entitlements for the mkpk menu-bar client.
  __TEAM_PREFIX__ is replaced with "TEAMID." by sign.sh (the team prefix is only
  known at signing). sign.sh keeps the hardened runtime, required for notarization.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- iCloud Keychain sync of imported invites (secrets stay encrypted). -->
  <key>keychain-access-groups</key>
  <array>
    <string>__TEAM_PREFIX__ru.eg23.mkpk.client</string>
  </array>
</dict>
</plist>
